# Supabase — project "dabz-system-new"
# Values come from: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server only. Bypasses row level security — never expose to the browser
# and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Staff sign in with a username; Supabase Auth keys accounts by email, so the
# two are bridged by this fixed internal domain. It MUST match the domain the
# existing auth.users rows were created with.
SUPABASE_USERNAME_EMAIL_DOMAIN=dabz.local

# Optional. Used for auth redirect URLs; falls back to the Vercel URL, then
# http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
