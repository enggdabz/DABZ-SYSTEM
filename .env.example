# Supabase Project URL
# Dashboard -> Settings -> Data API -> Project URL
# Looks like: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key -- safe to expose in the browser.
# Dashboard -> Settings -> API Keys -> "Legacy anon, service_role API keys" tab -> anon
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key -- SECRET. Bypasses Row Level Security.
# Never commit this, never expose it to the browser.
# Dashboard -> Settings -> API Keys -> "Legacy anon, service_role API keys" tab -> service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY=
